      "postinstall": "electron-builder install-app-deps",
      "test": "npm run test:renderer && npm run test:main",
      "e2e": "npm run build && playwright test",
      "test:renderer": "esbuild src/renderer/src/lib/check.ts --bundle --platform=node --format=esm --alias:@shared=./src/shared --outfile=node_modules/.cache/memo-check.mjs --log-level=error && node node_modules/.cache/memo-check.mjs",
      "test:main": "esbuild src/main/check.ts --bundle --platform=node --format=cjs --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --external:better-sqlite3 --outfile=node_modules/.cache/main-check.cjs --log-level=error && ELECTRON_RUN_AS_NODE=1 electron node_modules/.cache/main-check.cjs",
      "build:mcp": "esbuild src/mcp/server.ts --bundle --platform=node --format=cjs --target=node20 --alias:electron=./src/mcp/electron-shim.ts --alias:@shared=./src/shared --external:better-sqlite3 --outfile=out/mcp/server.js --log-level=warning",
      "test:mobile": "esbuild src/mobile/db.check.ts --bundle --platform=node --format=esm --alias:electron=./test/electron-stub.ts --alias:@shared=./src/shared --alias:better-sqlite3=./src/mobile/shims/better-sqlite3.ts --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" --outfile=node_modules/.cache/mobile-check.mjs --log-level=error && cp node_modules/@sqlite.org/sqlite-wasm/dist/sqlite3.wasm node_modules/.cache/ && node node_modules/.cache/mobile-check.mjs",
      "build:mobile": "vite build -c vite.mobile.config.ts && cap sync android",
      "android:apk": "npm run build:mobile && cd android && ./gradlew assembleDebug",
      "typecheck:mobile": "tsc --noEmit -p tsconfig.mobile.json",
      "android:smoke": "node scripts/android-smoke.mjs"
    }
